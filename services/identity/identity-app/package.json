    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.11",
    "@types/node": "^22.0.0"
  }
}
