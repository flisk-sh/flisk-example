# Flisk writes generated configs here on `flisk up` / `tilt up`.
# Keep the folder in git; ignore everything Tilt regenerates.
**/.autogenerated/*
!**/.autogenerated/.gitkeep

# Flisk (generated files and secrets)
.flisk/.flisk-out/
.flisk/.project-id
.flisk/smoke/
